  audioSource: {fileID: 565467281}
  subtitleText: {fileID: 1040696530}
  subtitles:
  - text: If one opens their eyes to the world, they may begin to see.
    startTime: 0
    endTime: 4
  - text: A woman, weeping for what she has lost.
    startTime: 4
    endTime: 7.7
  - text: A leader, sharing his wisdom out of compassion.
    startTime: 7.7
    endTime: 12.2
  - text: A man who lives by the river,
    startTime: 12.2
    endTime: 14.5
  - text: and contemplating the current discovered that all things are one.
    startTime: 14.5
    endTime: 19.5
  - text: And a player, who moves his pieces and uses his wit to deceive his opponent,
    startTime: 19.5
    endTime: 24.7
  - text: yet does not see the hand that moved his own.
    startTime: 24.7
    endTime: 27.7
  - text: Each believes themselves separate.
    startTime: 27.9
    endTime: 30.6
  - text: Each shapes the world around them.
    startTime: 30.6
    endTime: 33.5
  - text: Yet all are part of the same scenery.
    startTime: 33.5
    endTime: 37.1
  - text: And to the awakened eye,
    startTime: 37.1
    endTime: 39.3
  - text: they are not many but one.
    startTime: 39.3
    endTime: 42.8
