  m_Script: {fileID: 11500000, guid: 576de1934f39b3f43b8a4fae28765219, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  rounds:
  - pairs:
    - phrase: "\u201CI am valuable \nif I am \nrecognized.\u201D"
      correctSymbol: Ignorance
    - phrase: "\u201CI want to \nbe admired.\u201D"
      correctSymbol: Desire
    - phrase: "\u201CI need that\n approval.\u201D"
      correctSymbol: Attachment
    - phrase: "\u201CJealousy and \ninsecurity are \nconsuming me.\u201D"
      correctSymbol: Suffering
  - pairs:
    - phrase: "\u201CI want to \nappear \nenlightened.\u201D"
      correctSymbol: Desire
    - phrase: "\u201CI need to hold \nonto this image.\u201D"
      correctSymbol: Attachment
    - phrase: '"I am always

        afraid of what

        other people say"'
      correctSymbol: Suffering
    - phrase: "\u201CBeing \u2018spiritual\u2019 \nmakes me \nsuperior.\u201D"
      correctSymbol: Ignorance
  - pairs:
    - phrase: "\u201CI am dissatisfied \nwith what \nI have.\u201D"
      correctSymbol: Suffering
    - phrase: "\u201CHaving money \ngives security.\u201D"
      correctSymbol: Ignorance
    - phrase: "\u201CI need to maintain \nand increase \nwhat I have.\u201D"
      correctSymbol: Attachment
    - phrase: "\u201CI want to \nearn more.\u201D"
      correctSymbol: Desire
